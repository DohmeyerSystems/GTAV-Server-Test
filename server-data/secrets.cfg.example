# License Key von https://portal.cfx.re  (Server -> Registration Keys)
sv_licenseKey "CHANGE_ME"

# Datenbank (MariaDB) – Werte müssen zu scripts/setup-database.sh passen
set mysql_connection_string "mysql://fivem:CHANGE_ME@127.0.0.1:3306/qbox?charset=utf8mb4"

# Admins (Hauptadmin = group.admin). Identifier im txAdmin/Logs nachsehen.
# add_principal identifier.fivem:1234567 group.admin
# add_principal identifier.license:abcdef0123456789 group.admin

# Optional: rcon deaktiviert lassen (Sicherheit). txAdmin nutzen.
